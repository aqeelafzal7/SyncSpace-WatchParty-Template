
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User Profiles: Users can read all profiles but only write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rooms
    match /rooms/{roomId} {
      // Authenticated users can list/read rooms
      allow read: if request.auth != null;
      
      // Only logged-in users can actually create or edit rooms
      allow write: if request.auth != null;
      
      // Messages inside a room
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // System Settings: Everyone can read (for maintenance gate), only admins can write
    match /settings/system {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Analytics
    match /analytics/{docId} {
      allow create: if true;
      allow read: if isAdmin();
    }
  }
}
